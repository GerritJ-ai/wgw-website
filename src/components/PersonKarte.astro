---
import { Image } from 'astro:assets';
import type { Person } from '../data/team';
interface Props {
  person: Person;
}
const { person } = Astro.props;
---

<article class="pk">
  <Image src={person.bild} alt={`Portrait von ${person.name}`} width={480} height={600} fit="cover" position="top" />
  <div class="pk__text">
    <h3>{person.name}</h3>
    <p class="pk__rolle">{person.rolle}</p>
    <p class="pk__seit etikett">Seit {person.seit} in der WGW</p>
    <details>
      <summary>Ämter und Ausschüsse</summary>
      <dl>
        {person.aemter.map(([zeit, amt]) => (
          <>
            <dt>{zeit}</dt>
            <dd>{amt}</dd>
          </>
        ))}
      </dl>
    </details>
  </div>
</article>

<style>
  .pk { background: var(--blatt); border: var(--linie) solid var(--tinte); display: flex; flex-direction: column; }
  .pk img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; background: var(--wiese); border-bottom: var(--linie) solid var(--tinte); }
  .pk__text { padding: 1.1rem 1.25rem 1.2rem; display: flex; flex-direction: column; flex: 1; }
  h3 { margin-bottom: 0.3rem; }
  .pk__rolle { color: var(--rot-tief); font-weight: 650; font-size: 0.97rem; line-height: 1.38; margin-bottom: 0.5rem; }
  .pk__seit { color: var(--tinte-weich); margin-bottom: 0.9rem; }
  details { margin-top: auto; border-top: 1px solid var(--tinte); padding-top: 0.75rem; font-size: 0.93rem; }
  summary { cursor: pointer; font-weight: 650; }
  dl { margin: 0.8rem 0 0; display: grid; grid-template-columns: auto 1fr; gap: 0.3rem 0.9rem; }
  dt { color: var(--tinte-weich); white-space: nowrap; font-variant-numeric: tabular-nums; }
  dd { margin: 0; }
</style>

---
// Zeigt die letzten Instagram-Beiträge. Die Daten holt scripts/fetch-instagram.mjs beim Build;
// Bilder liegen danach lokal auf der Seite – Besucher bauen keine Verbindung zu Instagram auf.
import feed from '../data/instagram.json';
import { SITE, u } from '../lib/site';
interface Props { anzahl?: number }
const { anzahl = 6 } = Astro.props;
const posts = (feed.posts as any[]).slice(0, anzahl);
const tag = (t: string) => new Date(t).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---
{posts.length > 0 ? (
  <ul class="ig">
    {posts.map((p) => (
      <li>
        <a href={p.permalink} target="_blank" rel="noopener" class="ig__post">
          <div class="ig__bild"><img src={u(p.image)} alt={p.alt || `Instagram-Beitrag vom ${tag(p.timestamp)}`} width={p.width} height={p.height} loading="lazy" decoding="async" /></div>
          {p.type !== 'IMAGE' && <span class="ig__typ etikett">{p.type === 'VIDEO' ? 'Video' : 'Galerie'}</span>}
          <div class="ig__text">
            <time class="etikett" datetime={p.timestamp}><i class="sig sig--aktuelles" aria-hidden="true"></i>{tag(p.timestamp)}</time>
            {p.caption && <p>{p.caption}</p>}
          </div>
        </a>
      </li>
    ))}
  </ul>
) : (
  <div class="ig-leer feld">
    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor"/></svg>
    <div>
      <h3>Neuigkeiten gibt es auf Instagram</h3>
      <p>Termine, Fotos und kurze Berichte aus Verein und Fraktion veröffentlichen wir auf unserem Instagram-Kanal <strong>@{SITE.instagram.name}</strong>.</p>
      <a class="btn" href={SITE.instagram.url} target="_blank" rel="noopener">Zum Instagram-Kanal</a>
    </div>
  </div>
)}
<style>
  .ig { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); }
  .ig__post { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; background: var(--blatt); border: var(--linie) solid var(--tinte); color: var(--tinte); text-decoration: none; }
  .ig__bild { aspect-ratio: 4 / 5; overflow: hidden; border-bottom: var(--linie) solid var(--tinte); background: var(--wiese); }
  .ig__bild img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--aus); }
  .ig__post:hover img, .ig__post:focus-visible img { transform: scale(1.035); }
  .ig__typ { position: absolute; top: 0.7rem; right: 0.7rem; background: var(--tinte); color: #fff; padding: 0.28em 0.6em; }
  .ig__text { padding: 0.95rem 1.1rem 1.15rem; font-size: 0.97rem; line-height: 1.42; }
  .ig__text time { display: flex; align-items: center; gap: 0.55rem; color: var(--tinte-weich); }
  .ig__text p { margin: 0.4rem 0 0; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ig-leer { display: grid; grid-template-columns: auto 1fr; gap: 1.5rem; align-items: start; }
  .ig-leer svg { color: var(--rot); }
  .ig-leer h3 { font-size: 1.5rem; }
  .ig-leer p { max-width: 52ch; }
  @media (max-width: 520px) { .ig-leer { grid-template-columns: 1fr; } }
</style>

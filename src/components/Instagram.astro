---
// Zeigt die letzten Instagram-Beiträge. Die Daten holt scripts/fetch-instagram.mjs beim Build;
// Bilder liegen danach lokal auf der Seite – Besucher bauen keine Verbindung zu Instagram auf.
import feed from '../data/instagram.json';
import { SITE, u } from '../lib/site';
interface Props { anzahl?: number }
const { anzahl = 6 } = Astro.props;
const posts = (feed.posts as any[]).slice(0, anzahl);
const tag = (t: string) => new Date(t).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---
{posts.length > 0 ? (
  <ul class="ig">
    {posts.map((p) => (
      <li>
        <a href={p.permalink} target="_blank" rel="noopener" class="ig__post">
          <img src={u(p.image)} alt={p.alt || `Instagram-Beitrag vom ${tag(p.timestamp)}`} width={p.width} height={p.height} loading="lazy" decoding="async" />
          {p.type !== 'IMAGE' && <span class="ig__typ">{p.type === 'VIDEO' ? 'Video' : 'Galerie'}</span>}
          <div class="ig__text">
            <time datetime={p.timestamp}>{tag(p.timestamp)}</time>
            {p.caption && <p>{p.caption}</p>}
          </div>
        </a>
      </li>
    ))}
  </ul>
) : (
  <div class="ig-leer">
    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor"/></svg>
    <div>
      <h3>Neuigkeiten gibt es auf Instagram</h3>
      <p>Termine, Fotos und kurze Berichte aus Verein und Fraktion veröffentlichen wir auf unserem Instagram-Kanal <strong>@{SITE.instagram.name}</strong>.</p>
      <a class="btn" href={SITE.instagram.url} target="_blank" rel="noopener">Zum Instagram-Kanal</a>
    </div>
  </div>
)}
<style>
  .ig { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .ig__post { position: relative; display: block; border-radius: var(--radius); overflow: hidden; background: var(--tinte); aspect-ratio: 4 / 5; color: #fff; text-decoration: none; }
  .ig__post img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s, opacity 0.3s; }
  .ig__post:hover img, .ig__post:focus-visible img { transform: scale(1.04); opacity: 0.85; }
  .ig__typ { position: absolute; top: 0.8rem; right: 0.8rem; background: rgb(21 24 29 / 0.75); font-size: 0.72rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.25em 0.7em; border-radius: 999px; }
  .ig__text { position: absolute; inset: auto 0 0 0; padding: 3.5rem 1.1rem 1rem; background: linear-gradient(transparent, rgb(21 24 29 / 0.88)); font-size: 0.93rem; line-height: 1.4; }
  .ig__text time { font-size: 0.78rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.85; }
  .ig__text p { margin: 0.25rem 0 0; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ig-leer { display: flex; gap: 1.5rem; align-items: flex-start; background: #fff; border: 1px dashed var(--linie); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 2.5rem); color: var(--rot); }
  .ig-leer div { color: var(--text); }
  .ig-leer p { max-width: 55ch; }
  @media (max-width: 520px) { .ig-leer { flex-direction: column; } }
</style>

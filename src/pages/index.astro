---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Kartenblatt from '../components/Kartenblatt.astro';
import Instagram from '../components/Instagram.astro';
import BerichtKarte from '../components/BerichtKarte.astro';
import { SITE, u } from '../lib/site';

const berichte = (await getCollection('berichte'))
  .filter((b) => !b.data.title.startsWith('Portrait'))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const themen = [
  { titel: 'Grundsätzliches', text: 'Unabhängig, ohne Fraktionszwang und keiner Ideologie verpflichtet: unsere Prinzipien.', anker: 'grundsaetzliches' },
  { titel: 'Familie und Vereine', text: 'Schule, Kita, Bauplätze und ein lebendiges Vereinsleben, das Herz unseres Dorfes.', anker: 'familie' },
  { titel: 'Umwelt und Zukunft', text: 'Natur erhalten, Witzwort weiterentwickeln und bei der Energie neue Wege gehen.', anker: 'umwelt' },
];
---

<Base>
  <Kartenblatt />

  <section class="abschnitt">
    <div class="wrap">
      <div class="auftakt">
        <h2>Zwei Bereiche, ein Ziel: gemeinsam für Witzwort.</h2>
        <p class="lead">Bereits 1978 wurde die WGW gegründet, weil sich Witzworter Bürgerinnen und Bürger aktiv für ihr Dorf einbringen wollten. Seitdem ist sie fester Bestandteil der Gemeinde, als Verein und als Fraktion.</p>
      </div>
      <div class="bereiche">
        <article>
          <h3><i class="sig sig--verein" aria-hidden="true"></i>Der Verein</h3>
          <p class="etikett bereiche__ort">Versammlungen im Dörpshuus</p>
          <p class="bereiche__satz">Dorfleben pflegen und zusammenhalten.</p>
          <p>Ein Zusammenschluss von Dorfbewohnern, die den Sinn ihres Lebens nicht zwangsläufig in der Politik suchen. Verwurzelt in Familie, Gemeinschaft und den Vereinen der Gemeinde wollen wir den dörflichen Charakter erhalten, mit Angeboten für alle, ob Mitglied oder nicht.</p>
          <ul class="liste-punkt">
            <li>Witzworter Weihnachtsmarkt mit Tannenbaumverkauf</li>
            <li>Ausflug zur Tolk-Schau mit den Kleinsten des Dorfes</li>
            <li>Gemeinsames Dorfgrillen</li>
          </ul>
          <a class="pfeil" href={u('/verein/')}>Zum Verein</a>
        </article>
        <article>
          <h3><i class="sig sig--fraktion" aria-hidden="true"></i>Die Fraktion</h3>
          <p class="etikett bereiche__ort">Im Gemeinderat seit 1978</p>
          <p class="bereiche__satz">Kommunalpolitik mit Sachverstand.</p>
          <p>Wir möchten alle Menschen, unabhängig ihrer politischen Orientierung, in unsere kommunalpolitische Arbeit einbinden. Neutral und unabhängig von herkömmlichen Parteien, konstruktiv und mit kritischem Blick für das Notwendige und Machbare.</p>
          <ul class="liste-punkt">
            <li>Seit Gründung ohne Unterbrechung politische Mehrheit</li>
            <li>Stellt den Bürgermeister der Gemeinde</li>
            <li>Arbeitet ohne Fraktionszwang</li>
          </ul>
          <a class="pfeil" href={u('/fraktion/')}>Zur Fraktion</a>
        </article>
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt--marsch" id="aktuelles">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Neues von der WGW</h2>
        <a class="pfeil" href={SITE.instagram.url} target="_blank" rel="noopener">@{SITE.instagram.name} auf Instagram</a>
      </div>
      <Instagram />
    </div>
  </section>

  <section class="abschnitt">
    <div class="wrap programm">
      <div class="programm__kopf">
        <h2>Dafür steht die WGW</h2>
        <p class="lead">Drei Themenfelder, ein Anspruch: konstruktiv, unabhängig und immer am Wohl der Gemeinde ausgerichtet.</p>
        <a class="pfeil" href={u('/programm/')}>Ganzes Programm lesen</a>
      </div>
      <ul class="themen">
        {themen.map((t) => (
          <li>
            <a href={u(`/programm/#${t.anker}`)}>
              <h3>{t.titel}</h3>
              <p>{t.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="abschnitt abschnitt--marsch">
    <div class="wrap">
      <div class="kopfzeile">
        <h2>Aus Verein und Fraktion</h2>
        <a class="pfeil" href={u('/aktuelles/')}>Alle Berichte</a>
      </div>
      <div class="rueckblick">
        {berichte.map((b, i) => <BerichtKarte bericht={b} gross={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="abschnitt abschnitt--forst">
    <div class="wrap schluss">
      <div>
        <h2>Du hast uns gerade noch gefehlt.</h2>
        <p class="lead">Je mehr Mitglieder mitmachen, desto vielfältiger sind unsere Möglichkeiten. Wir freuen uns über unverbindliches Interesse, nette Gespräche, Anregungen und über jedes neue Mitglied.</p>
      </div>
      <div class="schluss__aktionen">
        <a class="btn" href={u('/mitglied-werden/')}>Mitglied werden</a>
        <a class="btn btn--hell" href={u('/team/')}>Ansprechpartner</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .auftakt { display: grid; grid-template-columns: 1.15fr 1fr; gap: 1rem clamp(2rem, 6vw, 5rem); align-items: end; margin-bottom: clamp(2.2rem, 5vw, 3.5rem); }
  .auftakt h2 { margin: 0; }
  .auftakt .lead { margin: 0; }

  .bereiche { display: grid; grid-template-columns: 1fr 1fr; border-top: var(--linie) solid var(--tinte); }
  .bereiche article { padding: clamp(1.8rem, 4vw, 3rem) 0; display: flex; flex-direction: column; align-items: flex-start; }
  .bereiche article:first-child { padding-right: clamp(1.5rem, 4vw, 3.5rem); border-right: var(--linie) solid var(--tinte); }
  .bereiche article:last-child { padding-left: clamp(1.5rem, 4vw, 3.5rem); }
  .bereiche h3 { display: flex; align-items: center; gap: 0.5em; font-size: clamp(1.75rem, 3vw, 2.4rem); margin-bottom: 0.35em; }
  .bereiche h3 .sig { font-size: 0.58em; }
  .bereiche__ort { color: var(--tinte-weich); margin-bottom: 1.1rem; }
  .bereiche__satz { font-weight: 650; font-size: 1.2rem; line-height: 1.35; margin-bottom: 0.8em; }
  .bereiche .liste-punkt { margin: 0.5rem 0 1.8rem; }
  .bereiche .pfeil { margin-top: auto; }

  .programm { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 2rem clamp(2rem, 7vw, 6rem); align-items: start; }
  .programm__kopf .lead { margin-bottom: 1.6rem; }
  .themen { list-style: none; margin: 0; padding: 0; border-top: var(--linie) solid var(--tinte); }
  .themen li { border-bottom: var(--linie) solid var(--tinte); }
  .themen a { display: grid; grid-template-columns: 1fr auto; column-gap: 1.5rem; align-items: center; padding: 1.5rem 0.2rem; color: inherit; text-decoration: none; transition: background 0.2s var(--aus), padding 0.25s var(--aus); }
  .themen a::after { content: ''; grid-row: 1 / 3; grid-column: 2; width: 0.8rem; height: 0.8rem; border-top: 2.5px solid var(--rot); border-right: 2.5px solid var(--rot); transform: rotate(45deg); margin-right: 0.5rem; }
  .themen h3 { font-size: clamp(1.5rem, 2.6vw, 2.05rem); margin: 0 0 0.2em; }
  .themen p { margin: 0; color: var(--tinte-weich); max-width: 46ch; }
  .themen a:hover, .themen a:focus-visible { background: var(--marsch); padding-inline: 1.1rem 0.9rem; }

  .rueckblick { display: grid; grid-template-columns: 1.35fr 1fr; grid-template-rows: auto auto; gap: 1.5rem; }
  .rueckblick :global(.bk--gross .bk__bild) { position: relative; }
  .rueckblick :global(.bk--gross .bk__bild img) { position: absolute; inset: 0; }
  .rueckblick > :global(:first-child) { grid-row: 1 / 3; }

  .schluss { display: grid; grid-template-columns: 1.5fr auto; gap: 2rem 4rem; align-items: center; }
  .schluss h2 { margin-bottom: 0.4em; }
  .schluss .lead { margin: 0; }
  .schluss__aktionen { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  @media (max-width: 860px) {
    .auftakt, .programm, .schluss, .rueckblick { grid-template-columns: 1fr; }
    .rueckblick > :global(:first-child) { grid-row: auto; }
    .bereiche { grid-template-columns: 1fr; }
    .bereiche article:first-child { padding-right: 0; border-right: 0; border-bottom: var(--linie) solid var(--tinte); }
    .bereiche article:last-child { padding-left: 0; }
  }
</style>

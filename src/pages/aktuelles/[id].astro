---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u, datum } from '../../lib/site';

export async function getStaticPaths() {
  const berichte = (await getCollection('berichte')).sort((a, b) => +b.data.date - +a.data.date);
  return berichte.map((bericht, i) => ({
    params: { id: bericht.id },
    props: { bericht, neuer: berichte[i - 1], aelter: berichte[i + 1] },
  }));
}

const { bericht, neuer, aelter } = Astro.props;
const { Content } = await render(bericht);
const { title, date, bereich, teaser } = bericht.data;
---

<Base title={title} description={teaser}>
  <article>
    <header class="kopf">
      <div class="schmal">
        <h1>{title}</h1>
        <p class="meta etikett">
          <i class={`sig sig--${bereich}`} aria-hidden="true"></i>
          <a href={u(`/${bereich}/`)}>{bereich === 'verein' ? 'Verein' : 'Fraktion'}</a>
          <time datetime={date.toISOString().slice(0, 10)}>{datum(date)}</time>
        </p>
      </div>
    </header>
    <div class="schmal prosa inhalt">
      <Content />
    </div>
  </article>

  <nav class="schmal blaettern" aria-label="Weitere Berichte">
    {aelter ? <a href={u(`/aktuelles/${aelter.id}/`)}><span>← Älter</span>{aelter.data.title}</a> : <span />}
    {neuer ? <a class="rechts" href={u(`/aktuelles/${neuer.id}/`)}><span>Neuer →</span>{neuer.data.title}</a> : <span />}
  </nav>
  <p class="schmal zurueck"><a class="pfeil" href={u('/aktuelles/')}>Alle Berichte</a></p>
</Base>

<style>
  .kopf { background: var(--marsch); border-bottom: var(--linie) solid var(--tinte); padding-block: clamp(2.4rem, 6vw, 4.2rem) clamp(1.8rem, 4vw, 2.6rem); }
  .kopf h1 { font-size: clamp(1.95rem, 4.4vw, 3.2rem); margin-bottom: 0.5em; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.7rem; align-items: center; margin: 0; }
  .meta a { color: var(--tinte); }
  .meta time { margin-left: 0.6rem; color: var(--tinte-weich); }
  .inhalt { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .inhalt :global(img) { margin-inline: auto; max-height: 85vh; width: auto; }
  .blaettern { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; border-top: var(--linie) solid var(--tinte); padding-top: 1.5rem; }
  .blaettern a { text-decoration: none; color: var(--tinte); font-weight: 600; line-height: 1.35; }
  .blaettern a span { display: block; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--rot-tief); margin-bottom: 0.2rem; }
  .blaettern .rechts { text-align: right; }
  .zurueck { padding-block: 2rem 4rem; }
</style>

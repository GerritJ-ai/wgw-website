---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Mail from '../components/Mail.astro';
import { SITE, u } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.beschreibung } = Astro.props;
const seitentitel = title ? `${title} · ${SITE.name}` : `${SITE.name} (WGW) – ${SITE.claim}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(u('/og.jpg'), Astro.site);

const nav = [
  { href: '/aktuelles/', label: 'Aktuelles' },
  { href: '/verein/', label: 'Verein' },
  { href: '/fraktion/', label: 'Fraktion' },
  { href: '/programm/', label: 'Programm' },
  { href: '/team/', label: 'Team' },
];
const pfad = Astro.url.pathname;
const aktiv = (href: string) => pfad.startsWith(u(href));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#c4161c" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>

    <header class="kopf">
      <div class="wrap kopf__innen">
        <a class="marke" href={u('/')} aria-label={`${SITE.name} – Startseite`}>
          <Image src={logo} alt="" width={52} height={51} loading="eager" />
          <span class="marke__text">
            <strong>Wählergemeinschaft</strong>
            <span>Witzwort</span>
          </span>
        </a>

        <nav class="nav" aria-label="Hauptnavigation">
          <details class="nav__mobil">
            <summary><span class="sr-only">Menü</span><span class="burger" aria-hidden="true"></span></summary>
            <ul>
              {nav.map((n) => <li><a href={u(n.href)} aria-current={aktiv(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
              <li><a class="btn" href={u('/mitglied-werden/')}>Mitglied werden</a></li>
            </ul>
          </details>
          <ul class="nav__breit">
            {nav.map((n) => <li><a href={u(n.href)} aria-current={aktiv(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
            <li><a class="btn" href={u('/mitglied-werden/')}>Mitglied werden</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt"><slot /></main>

    <footer class="fuss">
      <div class="wrap fuss__raster">
        <div>
          <p class="fuss__marke">Wählergemeinschaft Witzwort</p>
          <p>Seit 1978 unabhängig und parteifrei für unser Dorf. Verein und Fraktion – gemeinsam für Witzwort.</p>
          <a class="btn btn--linie-hell" href={SITE.instagram.url} target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor"/></svg>
            @{SITE.instagram.name}
          </a>
        </div>
        <div>
          <h2>Verein</h2>
          <p>
            {SITE.verein.name}<br />{SITE.verein.rolle}<br />
            <a href={`tel:${SITE.verein.telefon.replace(/\s/g, '')}`}>{SITE.verein.telefon}</a><br />
            <Mail adresse={SITE.verein.email} />
          </p>
        </div>
        <div>
          <h2>Fraktion</h2>
          <p>
            {SITE.fraktion.name}<br />{SITE.fraktion.rolle}<br />
            <Mail adresse={SITE.fraktion.email} />
          </p>
        </div>
        <div>
          <h2>Seiten</h2>
          <ul>
            {nav.map((n) => <li><a href={u(n.href)}>{n.label}</a></li>)}
            <li><a href={u('/mitglied-werden/')}>Mitglied werden</a></li>
            <li><a href={u('/satzung/')}>Satzung</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap fuss__unten">
        <span>© {new Date().getFullYear()} Wählergemeinschaft Witzwort</span>
        <span><a href={u('/impressum/')}>Impressum</a> · <a href={u('/datenschutz/')}>Datenschutz</a></span>
      </div>
    </footer>
  </body>
</html>

<style>
  .kopf { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / 0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--linie); }
  .kopf__innen { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.6rem; }
  .marke { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--tinte); }
  .marke img { width: 52px; height: auto; flex: none; }
  .marke__text { display: grid; font-family: var(--kopf); line-height: 1.05; letter-spacing: -0.01em; }
  .marke__text strong { font-size: 1.02rem; font-weight: 700; }
  .marke__text span { font-size: 1.02rem; font-weight: 500; color: var(--rot); }

  .nav ul { list-style: none; margin: 0; padding: 0; }
  .nav a:not(.btn) { color: var(--tinte); text-decoration: none; font-weight: 600; font-size: 0.98rem; padding: 0.4rem 0; border-bottom: 2px solid transparent; }
  .nav a:not(.btn):hover, .nav a[aria-current='page'] { border-bottom-color: var(--rot); }
  .nav .btn { padding: 0.6em 1.1em; font-size: 0.95rem; }
  .nav__breit { display: flex; align-items: center; gap: 1.6rem; }
  .nav__mobil { display: none; }

  @media (max-width: 900px) {
    .nav__breit { display: none; }
    .nav__mobil { display: block; }
    .nav__mobil summary { list-style: none; cursor: pointer; width: 2.8rem; height: 2.8rem; display: grid; place-items: center; border-radius: 10px; border: 1px solid var(--linie); }
    .nav__mobil summary::-webkit-details-marker { display: none; }
    .burger, .burger::before, .burger::after { display: block; width: 1.25rem; height: 2px; background: var(--tinte); border-radius: 2px; transition: transform 0.2s; }
    .burger { position: relative; }
    .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
    .burger::before { top: -6px; }
    .burger::after { top: 6px; }
    .nav__mobil[open] .burger { background: transparent; }
    .nav__mobil[open] .burger::before { transform: translateY(6px) rotate(45deg); }
    .nav__mobil[open] .burger::after { transform: translateY(-6px) rotate(-45deg); }
    .nav__mobil ul { position: absolute; left: 0; right: 0; top: 100%; background: #fff; border-bottom: 1px solid var(--linie); padding: 0.5rem 1.25rem 1.5rem; display: grid; gap: 0.2rem; box-shadow: var(--schatten); }
    .nav__mobil li a:not(.btn) { display: block; padding: 0.8rem 0; font-size: 1.1rem; border-bottom: 1px solid var(--linie); }
    .nav__mobil .btn { margin-top: 1rem; justify-content: center; width: 100%; padding: 0.85em; }
  }

  .fuss { background: var(--tinte); color: #b9bdc6; padding-top: clamp(3rem, 6vw, 4.5rem); font-size: 0.98rem; }
  .fuss a { color: #fff; }
  .fuss a:not(.btn) { text-decoration-color: rgb(255 255 255 / 0.35); }
  .fuss__raster { display: grid; gap: 2.5rem; grid-template-columns: 1.6fr 1fr 1fr 1fr; padding-bottom: 3rem; }
  .fuss__marke { font-family: var(--kopf); font-size: 1.35rem; font-weight: 700; color: #fff; margin-bottom: 0.6rem; letter-spacing: -0.01em; }
  .fuss h2 { font-family: var(--lauf); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8a8f99; margin-bottom: 0.9rem; font-weight: 650; }
  .fuss ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
  .fuss .btn { margin-top: 0.4rem; font-size: 0.95rem; padding: 0.6em 1.1em; }
  .fuss__unten { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; justify-content: space-between; padding-block: 1.4rem; border-top: 1px solid rgb(255 255 255 / 0.12); font-size: 0.9rem; }
  @media (max-width: 820px) { .fuss__raster { grid-template-columns: 1fr 1fr; } .fuss__raster > :first-child { grid-column: 1 / -1; } }
  @media (max-width: 460px) { .fuss__raster { grid-template-columns: 1fr; } }
</style>
